# Usage: run-node-bin <tool> [args...]
NODE_PATH="$(dirname "$0")/../../node_modules"
export NODE_PATH
BINPATH="$NODE_PATH/.bin"
TOOL="$1"
shift
exec "$BINPATH/$TOOL" "$@"
