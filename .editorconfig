# src: ./.editorconfig
# @(#) : editorconfig template (shfmt reads the shell script settings from here)
#
# Copyright (c) 2026- atsushifx <https://github.com/atsushifx>
#
# This software is released under the MIT License.
# https://opensource.org/licenses/MIT

root = true


# ─────────────────────────────
# Base Settings
# ─────────────────────────────
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 2
tab_width = 2

# ─────────────────────────────
# Exclude directories/files
# ─────────────────────────────
[**/node_modules/*]
ignore = true

[**/.tools/*]
ignore = true

[.local/*]
ignore = true

[**/*.spec.sh]
ignore = true


# ─────────────────────────────
# Shell Scripts
# ─────────────────────────────
[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2
tab_width = 2

#  shell script formatter settings
# --language-dialect
shell_variant      = bash
simplify           = false
binary_next_line   = false
# --case-indent
switch_case_indent = false
space_redirects    = false
keep_padding       = true
# --func-next-line
function_next_line = false
# --minify
minify             = false

# PowerShell
[*.ps1]
indent_style = space
indent_size = 4
tab_width = 4


# ─────────────────────────────
# Source Code Files
# ─────────────────────────────
# TypeScript
#[*.{ts,tsx}]
#indent_style = space
#indent_size = 2
#tab_width = 2


# ─────────────────────────────
# Documents
# ─────────────────────────────
[*.md]
indent_style = space
indent_size = 2
tab_width = 2


# ─────────────────────────────
# configuration files
# ─────────────────────────────
[*.json]
indent_style = space
indent_size = 2
tab_width = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.ini]
indent_style = space
indent_size = 4
tab_width = 4

[*.toml]
indent_style = space
indent_size = 2
tab_width = 2

[*rc]
indent_style = space
indent_size = 2
tab_width = 2


# ─────────────────────────────
# Git Config Files
# ─────────────────────────────
[*.git*]
indent_style = tab
tab_width = 4

# ─────────────────────────────
# Special Files (e.g. Dockerfile, LICENSE)
# ─────────────────────────────
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4
tab_width = 4

# ignore files
[**/*ignore]
indent_style = space
indent_size = 2
tab_width = 2

# [Dockerfile]
# indent_style = space
# indent_size = 2
