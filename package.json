{
  "name": "@aglabo/dev-tools",
  "version": "0.1.1",
  "private": true,
  "description": "Development tools management package for aglabo projects",
  "keywords": [
    "template",
    "starter",
    "oss",
    "development"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aglabo/agla-dev-tools.git"
  },
  "license": "MIT",
  "author": "atsushifx",
  "type": "module",
  "scripts": {
    "prepare": "bash ./scripts/setup-dev-env.sh",
    "scan:secrets": "concurrently \"secretlint --secretlintrc ./configs/secretlint.config.yaml\" \"betterleaks git --config ./configs/betterleaks.toml\"",
    "check:dprint": "dprint check --list-different",
    "check:dprint:diff": "dprint check",
    "format:dprint": "dprint fmt",
    "check:sh": "bash runners/run-shfmt.sh --list .",
    "format:sh": "bash runners/run-shfmt.sh --format .",
    "lint:sh": "bash runners/run-shellcheck.sh ",
    "test:sh": "bash runners/run-shellspec.sh ",
    "test:sh:all": "bash runners/run-shellspec.sh all",
    "lint:gha": "concurrently \"pnpm run lint:gha:actions\" \"pnpm run lint:gha:workflows\"",
    "lint:gha:actions": "bash runners/run-actionlint.sh ",
    "lint:gha:workflows": "concurrently \"bash runners/run-ghalint.sh run\" \"bash runners/run-ghalint.sh act\"",
    "lint:spells": "cspell --config .vscode/cspell.json --cache --cache-location .cache/cspell/cSpellCache ",
    "lint:text": "bash runners/run-textlint.sh ",
    "lint:markdown": "bash runners/run-markdownlint.sh "
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@ls-lint/ls-lint": "^2.3.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "commitlint": "^21.2.4",
    "concurrently": "^10.0.6",
    "rimraf": "^6.1.3",
    "secretlint": "^13.0.7"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "@(#)": "Development tools management package"
}
